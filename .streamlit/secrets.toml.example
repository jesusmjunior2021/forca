# Copie para .streamlit/secrets.toml (local) ou cole em Streamlit Cloud > App > Settings > Secrets.
# NUNCA versione o secrets.toml real (adicione ao .gitignore).

[auth]
user = "equalizacao"
# SHA-256 da senha (gerar com: python tools/gerar_hash.py "sua-senha")
password_sha256 = "COLE_AQUI_O_HASH_SHA256_DA_SENHA"

# --- Opcional (fase 2): pasta do Google Drive com os arquivos mensais ---
# [drive]
# folder_id = "ID_DA_PASTA"          # trecho final da URL da pasta
#
# [gcp_service_account]               # conta de serviço; compartilhe a pasta com o e-mail dela (Leitor)
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
